{
	"name": "@lasymphonie/emdash-plugin-ai-alt-text",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.31.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.1",
		"@emdash-cms/plugin-test": "0.2.6",
		"emdash": "1.0.1",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"description": "Writes alt text for images with Claude, in each entry's language, building on your media library.",
	"license": "MIT",
	"author": "La Symphonie (https://lasymphonieagency.com)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DavidPivert/emdash-plugin-ai-alt-text.git"
	},
	"homepage": "https://github.com/DavidPivert/emdash-plugin-ai-alt-text#readme"
}
