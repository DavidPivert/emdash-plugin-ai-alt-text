{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "ai-alt-text",
	"name": "AI Alt Text",
	"publisher": "did:plc:tc7kmqcnt5ad4pumbxzxduap",

	"license": "MIT",
	"author": { "name": "La Symphonie", "url": "https://lasymphonieagency.com" },
	"security": { "email": "contact@lasymphonieagency.com" },
	"description": "Writes alt text for images with Claude, in each entry's language, building on your media library.",
	"keywords": ["accessibility", "alt text", "images", "ai", "wcag"],
	"repo": "https://github.com/DavidPivert/emdash-plugin-ai-alt-text",

	"release": {
		"artifacts": {
			"icon": { "file": "./icon.png" }
		}
	},

	// Trust contract — what runtime APIs the plugin asks for.
	// Changing these between releases requires a version bump because
	// installed users have consented to the old contract.
	//  - content:write        — required by content:beforeSave; saves alt text into entries.
	//  - content:read         — reads entries, their language and the entry they translate.
	//  - schema:read          — finds collections that have image fields.
	//  - media:read           — reads the media library alt text an image field inherits.
	//  - media:metadata:write — saves alt text on media library items (alt, caption, focal point only).
	//  - network:request      — calls the Claude API (only api.anthropic.com).
	"capabilities": [
		"content:read",
		"content:write",
		"schema:read",
		"media:read",
		"media:metadata:write",
		"network:request"
	],
	"allowedHosts": ["api.anthropic.com"],
	"storage": {
		"alt_log": { "indexes": ["collection", "status", "at"] }
	},

	"admin": {
		"pages": [{ "path": "/audit", "label": "Alt text", "icon": "image" }],
		"widgets": [{ "id": "activity", "title": "AI alt text", "size": "third" }],
		"settingsSchema": {
			"apiKey": {
				"type": "secret",
				"label": "Anthropic API key",
				"description": "From console.anthropic.com, scoped to a workspace. Stored encrypted. Without it, no alt text is written."
			},
			"model": {
				"type": "select",
				"label": "Claude model",
				"description": "Haiku is fast enough to run during saves. Sonnet and Opus write richer descriptions but take longer.",
				"options": [
					{ "value": "claude-haiku-4-5", "label": "Claude Haiku 4.5 (fast, recommended)" },
					{ "value": "claude-sonnet-5-5", "label": "Claude Sonnet 5.5" },
					{ "value": "claude-opus-5-5", "label": "Claude Opus 5.5" }
				],
				"default": "claude-haiku-4-5"
			},
			"mediaLanguage": {
				"type": "string",
				"label": "Media library language",
				"description": "Language tag of the alt text stored in the media library, which entries in that language inherit (for example fr or en). Empty means the site language."
			},
			"onSave": {
				"type": "boolean",
				"label": "Complete alt text when entries are saved",
				"description": "Describes images that have no alt text anywhere, and gives entries in other languages alt text in their own language. Alt text written by people is kept.",
				"default": true
			},
			"collections": {
				"type": "string",
				"label": "Collections",
				"description": "Comma-separated collection slugs. Empty means every collection with an image field."
			},
			"siteUrl": {
				"type": "url",
				"label": "Public site URL",
				"description": "Claude downloads the images used in entries from this address. Leave empty to use the site URL from EmDash settings.",
				"placeholder": "https://example.com"
			}
		}
	}
}
